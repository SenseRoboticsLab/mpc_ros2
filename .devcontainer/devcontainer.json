{
  "name": "ROS 2 Workspace humble-ros-base",
  "remoteUser": "user",
  "dockerComposeFile": "compose.yaml",
  "service": "mpc_ros2",

  "customizations" : {
    "jetbrains" : {
      "backend" : "CLion"
    }
  },
  "workspaceFolder": "/home/da/project/ros/bluerov2_ws/src/mpc_ros2",
  "workspaceMount": "source=${localWorkspaceFolder},target=/home/user/project/ros/bluerov2_ws/src/mpc_ros2,type=bind",
  // "mounts": ["source=/home/da/project/Thirdparty,target=/home/da/project/Thirdparty,type=bind"],
  "runArgs": [
      "--net=host"
  ]
}
